# Server config
NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com
LOG_LEVEL=info
LOG_TO_CONSOLE=false

# Your website domain(s) that will call this API from a browser, comma-separated.
# Your mobile app is unaffected by this (native apps don't send an Origin header).
# In production, requests from any other Origin are blocked.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Postgres ---
DATABASE_URL=postgres://ai_backend_user:changeme@localhost:5432/ai_backend
# Only used by docker-compose.yml to set up the Postgres container itself:
POSTGRES_PASSWORD=changeme

# --- Redis (cache, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change_this_to_a_random_string_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30

# --- LiteLLM proxy (fronts all cloud providers — see /litellm/config.yaml) ---
# Inside docker-compose, the app reaches it at http://litellm:4000 (set automatically
# in docker-compose.yml). If you run the backend outside Docker, point this at
# wherever your litellm container/service is reachable.
LITELLM_BASE_URL=http://127.0.0.1:4000
# Shared secret between the backend and LiteLLM — put the SAME value in general_settings.master_key
# via this env var. Generate a long random string.
LITELLM_MASTER_KEY=sk-litellm-change_this_to_a_random_string
# Password for LiteLLM's own Postgres (spend/usage tracking) — only used by docker-compose.
LITELLM_POSTGRES_PASSWORD=changeme

# --- AI Gateway: cloud provider keys (read by LiteLLM itself — only fill in the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

DEFAULT_DAILY_TOKEN_LIMIT=20000

# Admin bootstrap (run: npm run setup-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# --- Stripe billing ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxx

# --- Paymenter billing (self-hosted alternative/second gateway - https://paymenter.org) ---
# Only fill these in if you're running your own Paymenter instance. Leave blank to
# offer Stripe only; fill in both Stripe and Paymenter to let users choose either one.
PAYMENTER_URL=https://billing.yourdomain.com
PAYMENTER_API_TOKEN=
PAYMENTER_WEBHOOK_SECRET=change_this_to_a_random_string
PAYMENTER_PRODUCT_PRO=
PAYMENTER_PRODUCT_BUSINESS=

# --- SMTP (verification, password reset, usage alert emails) ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Your App Name <no-reply@yourdomain.com>"
